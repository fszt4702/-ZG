/* === 智肝 · 浅蓝极简 === */

page {
  background: #F4F7FA;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  color: #3C5068;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

/* === 布局 === */
.flex-row { display: flex; flex-direction: row; align-items: center; }
.flex-column { display: flex; flex-direction: column; }
.flex-between { display: flex; justify-content: space-between; align-items: center; }
.flex-center { display: flex; justify-content: center; align-items: center; }
.flex-1 { flex: 1; }

/* === 卡片 === */
.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 36rpx;
  margin: 20rpx 28rpx;
  border: 1rpx solid #E4EAF0;
}

/* === 按钮 === */
.btn-primary {
  background: #6C9BD8;
  color: #FFFFFF;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
  padding: 26rpx 48rpx;
  text-align: center;
  letter-spacing: 1rpx;
}

.btn-primary:active {
  background: #5A8DC8;
}

.btn-outline {
  background: transparent;
  color: #5A8CC8;
  border: 1rpx solid #C4CCD6;
  border-radius: 48rpx;
  font-size: 28rpx;
  font-weight: 400;
  padding: 20rpx 36rpx;
  text-align: center;
}

.btn-outline:active {
  background: #F0F3F6;
}

.btn-danger {
  background: #E8777A;
  color: #FFFFFF;
  border-radius: 48rpx;
  font-size: 28rpx;
  border: none;
  padding: 20rpx 36rpx;
  text-align: center;
}

/* === 文字 === */
.text-primary { color: #3C5068; }
.text-secondary { color: #8592A0; }
.text-muted { color: #B0B9C5; }
.text-accent { color: #6C9BD8; }
.text-green { color: #5CBF97; }
.text-orange { color: #EDA860; }
.text-red { color: #E8777A; }

.text-xs { font-size: 22rpx; }
.text-sm { font-size: 26rpx; }
.text-md { font-size: 28rpx; }
.text-lg { font-size: 32rpx; }
.text-xl { font-size: 36rpx; }
.text-xxl { font-size: 48rpx; }

.text-center { text-align: center; }

/* === 标签 === */
.tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
  font-weight: 500;
  letter-spacing: 0.5rpx;
}

.tag-normal { background: #E6F4EC; color: #5CBF97; }
.tag-abnormal { background: #FFECEC; color: #E8777A; }
.tag-mild { background: #FFF5E8; color: #EDA860; }
.tag-moderate { background: #FFF0E0; color: #D49550; }
.tag-severe { background: #FFECEC; color: #E8777A; }

/* === 页面容器 === */
.page-container {
  min-height: 100vh;
  background: #F4F7FA;
  padding-bottom: 20rpx;
}

/* === 分割线 === */
.divider {
  height: 1rpx;
  background: #E4EAF0;
  margin: 24rpx 0;
}

/* === 安全区 === */
.safe-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}
